# Django Settings
# Environments: config.settings.development | config.settings.staging |
# config.settings.production | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Supabase PostgreSQL connection. Production must include sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jtcode
DATABASE_CONN_MAX_AGE=60

# Authentication (Supabase)
SUPABASE_URL=https://your-project.supabase.co
# Issuer for the Supabase JWT (`https://<project>.supabase.co/auth/v1`).
# When set, tokens are verified against the matching issuer and JWKS endpoint.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_WEBHOOK_SIGNING_SECRET=replace_me

# ImageKit (File/Image Storage & CDN). ADR-002 canonical asset storage.
IMAGEKIT_PUBLIC_KEY=replace_me
IMAGEKIT_PRIVATE_KEY=replace_me
IMAGEKIT_ENDPOINT_URL=https://ik.imagekit.io/your-project
IMAGEKIT_UPLOAD_FOLDER=jt-code/development
IMAGEKIT_MAX_UPLOAD_BYTES=26214400
IMAGEKIT_UPLOAD_AUTH_TTL_SECONDS=300

# Redis (Cache + Celery Transport)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Kafka Event Bus
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=jt-code-api
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_PREFIX=jt-code.dev

# Sentry (Primary Monitoring Platform)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=jt-code-api@0.1.0

# n8n Orchestration
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_BASE_URL=http://localhost:8000/api/v1
N8N_WORKFLOW_PREFIX=jt-code
N8N_SENTRY_RELAY_SECRET=replace_me

# AI Gateway
AI_PROVIDER=echo
AI_GATEWAY_DEFAULT_POLICY=balanced
AI_GATEWAY_MAX_COST_USD=10.0
AI_GATEWAY_MAX_LATENCY_MS=30000
AI_GATEWAY_FALLBACK_ENABLED=true

# Agent runtime (apps.agents / LangGraph)
AGENT_MAX_ITERATIONS=6

# Billing & Subscriptions (Stripe)
BILLING_CREDIT_VALUE_USD=0.01
BILLING_FX_BUFFER=1.05
BILLING_MARGIN_MULTIPLIER=1.25
BILLING_DEFAULT_PLAN=free
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Feature flags (feature toggles)
FEATURE_FLAG_ENABLE_RAG=true
FEATURE_FLAG_ENABLE_IMAGES=true
FEATURE_FLAG_ENABLE_ANALYTICS=true
FEATURE_FLAG_ENABLE_BILLING=false

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Streamlit deployment
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GLOBAL_ROOT=. 

# OTel/Prometheus observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Agentic RAG (Supabase pgvector vector store)
# The `vector` extension + HNSW cosine index are created by the
# `knowledge.0003_add_pgvector_embeddings` migration on PostgreSQL.
PGVECTOR_ENABLED=true
VECTOR_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_EXTRACTED_BYTES=5242880
RAG_URL_FETCH_TIMEOUT_SECONDS=30
VECTOR_MIN_SIMILARITY=0.0

# Embedding provider credentials (server-side). Set only the provider in use:
#   RAG_EMBEDDING_PROVIDER=openai -> OPENAI_API_KEY
#   RAG_EMBEDDING_PROVIDER=gemini -> GEMINI_API_KEY, GEMINI_EMBEDDING_MODEL
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Governance & Compliance
AUDIT_EVENT_RETENTION_DAYS=2555
SAFETY_EVENT_RETENTION_DAYS=2555
CONSENT_VERSION=1.0

# Rate limiting (DRF throttle scopes)
THROTTLE_CHAT=60/hour
THROTTLE_IMAGES=30/hour
THROTTLE_EMBEDDINGS=120/hour
THROTTLE_CONVERSIONS=20/hour
THROTTLE_RESEARCH=10/hour
THROTTLE_BURST=30/minute

# Integrations
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BASE_DELAY=60
KAFKA_CONSUMER_GROUP_PREFIX=jt-code
