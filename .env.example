# Copy to .env for development. Do not use these placeholders in a deployable environment.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Supabase PostgreSQL is the only application database. Use a different,
# disposable project/database for CI and restore drills. Never commit real values.
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/DATABASE_NAME?sslmode=require
# pytest creates and drops test_<DATABASE_NAME> on this server (needs CREATEDB + pgvector).
TEST_DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/DATABASE_NAME?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# Leave empty: tokens are verified with the project's asymmetric JWKS keys.
SUPABASE_JWT_SECRET=
# Shared secret Supabase Database Webhooks send as "Authorization: Bearer <secret>".
SUPABASE_WEBHOOK_SIGNING_SECRET=replace_me
# Server-only secret key for the Supabase Auth Admin API. The publishable key
# belongs to the frontend only and is not read by this backend.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_ALLOW_ANONYMOUS_USERS=false


# Deployable profiles require PostgreSQL TLS, TLS Redis, HTTPS origins/endpoints,
# SASL_SSL Kafka, and non-placeholder secrets.
DATABASE_CONN_MAX_AGE=60
DATABASE_POOLER_MODE=direct
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_SSLROOTCERT=
DATABASE_APPLICATION_NAME=jt-code-api
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
HEALTHCHECK_EXTERNAL_DEPENDENCIES=false


IMAGEKIT_PUBLIC_KEY=replace_me
IMAGEKIT_PRIVATE_KEY=replace_me
IMAGEKIT_ENDPOINT_URL=https://ik.imagekit.io/your-project
IMAGEKIT_UPLOAD_FOLDER=jt-code/development
IMAGEKIT_MAX_UPLOAD_BYTES=26214400
IMAGEKIT_UPLOAD_AUTH_TTL_SECONDS=300

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=jt-code-api
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_PREFIX=jt-code.dev
KAFKA_CONSUMER_GROUP_PREFIX=jt-code
EVENT_OUTBOX_MAX_ATTEMPTS=10
EVENT_OUTBOX_MAX_BACKOFF_SECONDS=300
EVENT_OUTBOX_LEASE_SECONDS=60
EVENT_OUTBOX_RETENTION_DAYS=7
KAFKA_CONSUMER_MAX_ATTEMPTS=5
KAFKA_CONSUMER_RETRY_MAX_SECONDS=30
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=3
KAFKA_TOPIC_RETENTION_MS=604800000

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

CHAT_REQUEST_STALLED_TIMEOUT_SECONDS=660
CHAT_DISPATCH_GRACE_SECONDS=60
JOB_STALLED_TIMEOUT_SECONDS=660
CHAT_MAX_CONTEXT_MESSAGES=40
CHAT_SSE_HEARTBEAT_SECONDS=15
CHAT_SSE_POLL_SECONDS=1
CHAT_SSE_RECONCILIATION_SECONDS=30
CHAT_SSE_MAX_SECONDS=300

SENTRY_RELEASE=jt-code-api@0.1.0

N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=replace_me
N8N_WEBHOOK_SECRET=replace_me
N8N_CALLBACK_BASE_URL=http://localhost:8000/api/v1
N8N_WORKFLOW_PREFIX=jt-code
N8N_SENTRY_RELAY_SECRET=replace_me

AI_PROVIDER=echo
AI_GATEWAY_DEFAULT_POLICY=balanced
AI_GATEWAY_MAX_COST_USD=10.0
AI_GATEWAY_MAX_LATENCY_MS=30000
AI_GATEWAY_FALLBACK_ENABLED=true
AI_DEFAULT_MODEL_ALIAS=default-chat
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=0.5
AI_RETRY_MAX_BACKOFF_SECONDS=8
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# Gemini: server-only key; the provider model is chosen here, not by clients.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
# Llama: any OpenAI-compatible hosted/self-hosted endpoint (HTTPS in deployments).
LLAMA_API_BASE=
LLAMA_API_KEY=
LLAMA_DEFAULT_MODEL=
AGENT_MAX_ITERATIONS=6
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

BILLING_CREDIT_VALUE_USD=0.01
BILLING_FX_BUFFER=1.05
BILLING_MARGIN_MULTIPLIER=1.25
BILLING_DEFAULT_PLAN=free
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
STRIPE_PUBLISHABLE_KEY=

PGVECTOR_ENABLED=true
VECTOR_EMBEDDING_DIMENSIONS=1536
VECTOR_MIN_SIMILARITY=0.0
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_EXTRACTED_BYTES=5242880
RAG_URL_FETCH_TIMEOUT_SECONDS=30

AUDIT_EVENT_RETENTION_DAYS=2555
SAFETY_EVENT_RETENTION_DAYS=2555
CONSENT_VERSION=1.0
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BASE_DELAY=60
WEBHOOK_RETRY_MAX_SECONDS=3600
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
# Comma-separated trusted recipient DNS names; callbacks to any other host are rejected.
WEBHOOK_ALLOWED_HOSTS=callbacks.example.com
WEBHOOK_SIGNING_SECRET=replace_me
THROTTLE_CHAT=60/hour
THROTTLE_IMAGES=30/hour
THROTTLE_EMBEDDINGS=120/hour
THROTTLE_CONVERSIONS=20/hour
THROTTLE_RESEARCH=10/hour
THROTTLE_BURST=30/minute
