# Copy to .env for development. Do not use these placeholders in a deployable environment.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Supabase PostgreSQL is the only application database. Use a different,
# disposable project/database for CI and restore drills. Never commit real values.
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/DATABASE_NAME?sslmode=require
# pytest creates and drops test_<DATABASE_NAME> on this server (needs CREATEDB + pgvector).
TEST_DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/DATABASE_NAME?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# Leave empty: tokens are verified with the project's asymmetric JWKS keys.
SUPABASE_JWT_SECRET=
# Shared secret Supabase Database Webhooks send as "Authorization: Bearer <secret>".
SUPABASE_WEBHOOK_SIGNING_SECRET=replace_me
# Server-only secret key for the Supabase Auth Admin API. The publishable key
# belongs to the frontend only and is not read by this backend.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_ALLOW_ANONYMOUS_USERS=false


# Deployable profiles require PostgreSQL TLS, TLS Redis, HTTPS origins/endpoints,
# SASL_SSL Kafka, and non-placeholder secrets.
DATABASE_CONN_MAX_AGE=60
DATABASE_POOLER_MODE=direct
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_SSLROOTCERT=
DATABASE_APPLICATION_NAME=jt-code-api
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
HEALTHCHECK_EXTERNAL_DEPENDENCIES=false


IMAGEKIT_PUBLIC_KEY=replace_me
IMAGEKIT_PRIVATE_KEY=replace_me
IMAGEKIT_ENDPOINT_URL=https://ik.imagekit.io/your-project
IMAGEKIT_UPLOAD_FOLDER=jt-code/development
IMAGEKIT_MAX_UPLOAD_BYTES=26214400
IMAGEKIT_UPLOAD_AUTH_TTL_SECONDS=300
IMAGEKIT_UPLOAD_API_BASE=https://upload.imagekit.io/api
IMAGEKIT_API_BASE=https://api.imagekit.io/v1
# Verified against magic bytes; SVG is intentionally not allowed.
ASSET_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,application/json,application/zip,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,text/markdown,text/plain
IMAGEKIT_RECONCILE_BATCH_SIZE=200
IMAGEKIT_RECONCILE_INTERVAL_HOURS=24
IMAGEKIT_RECONCILE_MAX_DEPTH=6
ASSET_DELETE_MAX_ATTEMPTS=10
IMAGEKIT_SIGNED_URL_TTL_SECONDS=900
IMAGEKIT_API_TIMEOUT_SECONDS=30
ASSET_DELETE_GRACE_DAYS=7
ASSET_ORPHAN_GRACE_HOURS=24
IMAGEKIT_RECONCILE_PAGE_SIZE=100
IMAGEKIT_RECONCILE_MAX_PAGES=100
ASSET_LOCAL_FALLBACK_ENABLED=true

# Phase 12: CSV analytics runs and chart rendering use separate Celery queues.
ANALYTICS_ALLOWED_MIME_TYPES=text/csv,application/csv
ANALYTICS_MAX_INLINE_BYTES=5242880
ANALYTICS_MAX_DATASET_BYTES=26214400
ANALYTICS_MAX_RESULT_BYTES=26214400
ANALYTICS_MAX_DATASET_ROWS=100000
ANALYTICS_MAX_DATASET_COLUMNS=200
ANALYTICS_MAX_DATASET_CELLS=2000000
ANALYTICS_RESULT_PREVIEW_ROWS=100
ANALYTICS_MAX_CHART_POINTS=10000
ANALYTICS_MAX_PLOTLY_SPEC_BYTES=5242880
ANALYTICS_DOWNLOAD_TIMEOUT_SECONDS=30
ANALYTICS_TASK_SOFT_TIME_LIMIT_SECONDS=270
ANALYTICS_TASK_TIME_LIMIT_SECONDS=300
ANALYTICS_STALLED_AFTER_MINUTES=15
ANALYTICS_SANDBOX_MEMORY_MB=1536
ANALYTICS_SANDBOX_CPU_SECONDS=240
ANALYTICS_SANDBOX_TIMEOUT_SECONDS=250
ANALYTICS_INLINE_SPEC_BYTES=262144

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=jt-code-api
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_PREFIX=jt-code.dev
KAFKA_CONSUMER_GROUP_PREFIX=jt-code
EVENT_OUTBOX_MAX_ATTEMPTS=10
EVENT_OUTBOX_MAX_BACKOFF_SECONDS=300
EVENT_OUTBOX_LEASE_SECONDS=60
EVENT_OUTBOX_RETENTION_DAYS=7
KAFKA_CONSUMER_MAX_ATTEMPTS=5
KAFKA_CONSUMER_RETRY_MAX_SECONDS=30
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=3
KAFKA_TOPIC_RETENTION_MS=604800000

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

CHAT_REQUEST_STALLED_TIMEOUT_SECONDS=660
CHAT_DISPATCH_GRACE_SECONDS=60
JOB_STALLED_TIMEOUT_SECONDS=660
CHAT_MAX_CONTEXT_MESSAGES=40
CHAT_SSE_HEARTBEAT_SECONDS=15
CHAT_SSE_POLL_SECONDS=1
CHAT_SSE_RECONCILIATION_SECONDS=30
CHAT_SSE_MAX_SECONDS=300

SENTRY_RELEASE=jt-code-api@0.1.0

N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=replace_me
N8N_WEBHOOK_SECRET=replace_me
N8N_CALLBACK_BASE_URL=http://localhost:8000/api/v1
N8N_WORKFLOW_PREFIX=jt-code
N8N_SENTRY_RELAY_SECRET=replace_me

AI_PROVIDER=echo
AI_GATEWAY_DEFAULT_POLICY=balanced
AI_GATEWAY_MAX_COST_USD=10.0
AI_GATEWAY_MAX_LATENCY_MS=30000
AI_GATEWAY_FALLBACK_ENABLED=true
AI_DEFAULT_MODEL_ALIAS=default-chat
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=0.5
AI_RETRY_MAX_BACKOFF_SECONDS=8
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# Gemini: server-only key; the provider model is chosen here, not by clients.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
# Llama: any OpenAI-compatible hosted/self-hosted endpoint (HTTPS in deployments).
LLAMA_API_BASE=
LLAMA_API_KEY=
LLAMA_DEFAULT_MODEL=
AGENT_MAX_ITERATIONS=6
LANGGRAPH_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_COST_USD=0.50
AGENT_MAX_DURATION_SECONDS=300
# "rules" (deterministic) or "model" (classification alias, rules fallback).
AGENT_ROUTER_MODE=rules
AGENT_RUN_STALLED_TIMEOUT_SECONDS=660
AGENT_RUN_MAX_ATTEMPTS=3
MAX_CONCURRENT_AGENT_RUNS_PER_TENANT=10
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Tools / MCP (Phase 9). Generate keys with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOOL_CREDENTIALS_ENCRYPTION_KEYS=
EXTERNAL_API_TIMEOUT_SECONDS=20
TOOL_MAX_RESPONSE_BYTES=1048576
TOOL_MAX_OUTPUT_CHARS=20000
TOOL_MAX_ARGUMENT_BYTES=262144
TOOL_EGRESS_DENYLIST=metadata.google.internal,*.internal,*.local
TOOL_APPROVAL_TTL_SECONDS=86400
BROWSER_TOOL_ENABLED=false
SEARCH_API_BASE=https://api.search.brave.com/res/v1/web/search
SEARCH_API_KEY=
GITHUB_API_BASE=https://api.github.com
GITHUB_APP_ID=
# PEM with literal \n line breaks; server-only.
GITHUB_APP_PRIVATE_KEY=
TOOL_GITHUB_BRANCH_PREFIX=jt-code/
SLACK_API_BASE=https://slack.com/api
ENABLE_MCP=true
MCP_TOOL_TIMEOUT_SECONDS=30

BILLING_CREDIT_VALUE_USD=0.01
BILLING_FX_BUFFER=1.05
BILLING_MARGIN_MULTIPLIER=1.25
BILLING_DEFAULT_PLAN=free
# feature=credits pairs: reservation ceilings and flat/minimum prices per feature.
USAGE_RESERVATION_CREDITS=chat_messages=10,rag_queries=25,search_queries=40,knowledge_documents=100,image_generations=100,document_renders=20,file_conversions=15,workflow_executions=10,agent_runs=50,analysis_runs=10,api_calls=1
USAGE_FLAT_CREDITS=chat_messages=1,rag_queries=2,search_queries=5,knowledge_documents=10,image_generations=100,document_renders=20,file_conversions=15,workflow_executions=10,agent_runs=2,analysis_runs=10,api_calls=1
USAGE_RESERVATION_TTL_MINUTES=120
USAGE_RECONCILIATION_DRIFT_RATIO=0.01
MAX_CONCURRENT_JOBS_PER_TENANT=20
MAX_CONCURRENT_CHAT_REQUESTS_PER_TENANT=20
MAX_CONCURRENT_ANALYSIS_RUNS_PER_TENANT=5
THROTTLE_TENANT_MULTIPLIER=10
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
STRIPE_PUBLISHABLE_KEY=
STRIPE_API_VERSION=2023-10-16
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_EVENT_MAX_ATTEMPTS=8
# Checkout/Portal return URLs must use this origin or a CORS_ALLOWED_ORIGINS origin.
FRONTEND_URL=http://localhost:5173
BILLING_TOPUP_MIN_CENTS=500
BILLING_TOPUP_MAX_CENTS=100000
BILLING_AUTO_TOPUP_COOLDOWN_MINUTES=60

# Supabase pgvector is the only vector store (no on/off flag).
VECTOR_EMBEDDING_DIMENSIONS=1536
# Minimum cosine similarity for semantic candidates (0 = let fusion/reranking decide).
VECTOR_MIN_SIMILARITY=0.0
# gemini (GEMINI_API_KEY + GEMINI_EMBEDDING_MODEL) or openai (OPENAI_API_KEY + RAG_EMBEDDING_MODEL).
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_BATCH_SIZE=64
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_HYBRID_CANDIDATES=30
# "model" uses the AI gateway alias below; "deterministic" is offline only.
RAG_RERANKER=model
RAG_RERANK_MODEL_ALIAS=classification
RAG_JUDGE=model
RAG_JUDGE_MODEL_ALIAS=classification
RAG_MAX_CONTEXT_TOKENS=6000
RAG_EVAL_MIN_RECALL=0.8
RAG_EVAL_MIN_MRR=0.5
RAG_MAX_EXTRACTED_BYTES=5242880
RAG_URL_FETCH_TIMEOUT_SECONDS=30
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MAX_RETRIES=2
RAG_INGESTION_STALLED_MINUTES=30
RAG_INGESTION_MAX_RETRIES=3

AUDIT_EVENT_RETENTION_DAYS=2555
SAFETY_EVENT_RETENTION_DAYS=2555
CONSENT_VERSION=1.0
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BASE_DELAY=60
WEBHOOK_RETRY_MAX_SECONDS=3600
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
# Comma-separated trusted recipient DNS names; callbacks to any other host are rejected.
WEBHOOK_ALLOWED_HOSTS=callbacks.example.com
WEBHOOK_SIGNING_SECRET=replace_me
THROTTLE_CHAT=60/hour
THROTTLE_IMAGES=30/hour
THROTTLE_EMBEDDINGS=120/hour
THROTTLE_CONVERSIONS=20/hour
THROTTLE_RESEARCH=10/hour
THROTTLE_BURST=30/minute
THROTTLE_IP=300/minute
THROTTLE_AGENT_RUNS=20/hour
THROTTLE_ANALYTICS=30/hour
