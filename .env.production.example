# Production settings for docker-compose.prod.yml (single server).
#   cp .env.production.example .env.production && chmod 600 .env.production
# Never commit .env.production. Generate every password/secret with:
#   openssl rand -hex 32        (hex keeps Redis URLs valid without escaping)
# Database, Supabase, Redis and Kafka connections are wired by docker-compose.prod.yml from
# the passwords and keys below (full list near the end of this file).

# --- Broker credentials (used by docker-compose.prod.yml) -------------------------------
REDIS_CACHE_PASSWORD=
REDIS_BROKER_PASSWORD=
KAFKA_ADMIN_PASSWORD=
KAFKA_PRODUCER_PASSWORD=
KAFKA_CONSUMER_PASSWORD=
KAFKA_TOPIC_PREFIX=jt-code.production
KAFKA_CONSUMER_GROUP_PREFIX=jt-code
# Sizing for one server (adjust to its RAM): cache evicts at its limit; the broker rejects new jobs at its limit.
REDIS_CACHE_MAXMEMORY=256mb
REDIS_BROKER_MAXMEMORY=512mb
KAFKA_MEMORY=1G
WORKER_CONCURRENCY=4

# --- Monitoring (Grafana, Prometheus: localhost only, see docs/SELF_HOSTED_DEPLOYMENT.md) --
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d

# --- Django ----------------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
# One reverse proxy (Caddy/nginx) on the host in front of the API.
TRUSTED_PROXY_HOPS=1
METRICS_AUTH_TOKEN=

# --- Supabase (self-hosted in docker-compose.prod.yml) -----------------------------------
# docker-compose.prod.yml builds DATABASE_URL, SUPABASE_URL, the JWT issuer/JWKS URLs and
# SUPABASE_SECRET_KEY from these values; do not set those here.
# Public HTTPS address of the Supabase gateway (the host's TLS proxy -> 127.0.0.1:54321).
SUPABASE_PUBLIC_URL=https://supabase.example.com
SUPABASE_DB_PASSWORD=
# At least 32 characters. Then generate the two API keys from it:
#   python scripts/generate_supabase_keys.py "<SUPABASE_JWT_SECRET>"
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PG_META_CRYPTO_KEY=
SUPABASE_JWT_EXPIRY=3600
SUPABASE_WEBHOOK_SIGNING_SECRET=
SUPABASE_STORAGE_BUCKET=jt-code-assets
SUPABASE_STORAGE_PREFIX=jt-code/production
# Auth: where confirmation/recovery links land, and other allowed redirect URLs (comma-separated).
SUPABASE_SITE_URL=https://app.example.com
SUPABASE_REDIRECT_URLS=https://app.example.com
SUPABASE_DISABLE_SIGNUP=false
SUPABASE_MAILER_AUTOCONFIRM=false
# Auth emails (sign-up confirmation, password reset) go through your SMTP provider.
SUPABASE_SMTP_HOST=
SUPABASE_SMTP_PORT=587
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASS=
SUPABASE_SMTP_ADMIN_EMAIL=
SUPABASE_SMTP_SENDER_NAME=JT-Code


# --- Integrations ------------------------------------------------------------------------
AI_PROVIDER=gemini
RAG_EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WEBHOOK_SIGNING_SECRET=
WEBHOOK_ALLOWED_HOSTS=callbacks.example.com
TOOL_CREDENTIALS_ENCRYPTION_KEYS=
N8N_BASE_URL=https://n8n.example.com
N8N_WEBHOOK_BASE_URL=https://n8n.example.com
N8N_CALLBACK_BASE_URL=https://api.example.com/api/v1
N8N_API_KEY=
N8N_DISPATCH_SECRET=
N8N_WEBHOOK_SECRET=
N8N_SENTRY_RELAY_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Django and database tuning ---------------------------------------------------------
DJANGO_DEBUG=false
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_APPLICATION_NAME=jt-code-api
# Optional CA bundle path inside the container for sslmode=verify-full.
DATABASE_SSLROOTCERT=

# --- Error tracking ----------------------------------------------------------------------
SENTRY_RELEASE=jt-code-api@0.1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# --- Event outbox (PostgreSQL -> Kafka) --------------------------------------------------
KAFKA_CLIENT_ID=jt-code-api
EVENT_OUTBOX_MAX_ATTEMPTS=10
EVENT_OUTBOX_MAX_BACKOFF_SECONDS=300
EVENT_OUTBOX_LEASE_SECONDS=60

# --- Chat streaming ----------------------------------------------------------------------
CHAT_REQUEST_STALLED_TIMEOUT_SECONDS=660
CHAT_MAX_CONTEXT_MESSAGES=40
CHAT_SSE_HEARTBEAT_SECONDS=15
CHAT_SSE_POLL_SECONDS=1
CHAT_SSE_RECONCILIATION_SECONDS=30
CHAT_SSE_MAX_SECONDS=300

# --- AI gateway ---------------------------------------------------------------------------
AI_GATEWAY_DEFAULT_POLICY=balanced
AI_GATEWAY_MAX_COST_USD=10.0
AI_GATEWAY_MAX_LATENCY_MS=30000
AI_GATEWAY_FALLBACK_ENABLED=true
AI_DEFAULT_MODEL_ALIAS=default-chat
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=0.5
AI_RETRY_MAX_BACKOFF_SECONDS=8
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# Production refuses settings that disable Gemini safety filtering.
GEMINI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
# Optional second provider: any OpenAI-compatible Llama endpoint (must be https://).
LLAMA_API_BASE=
LLAMA_API_KEY=
LLAMA_DEFAULT_MODEL=

# --- Agents --------------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=6
LANGGRAPH_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_COST_USD=0.50
AGENT_MAX_DURATION_SECONDS=300
# "rules" (deterministic) or "model" (classification alias, rules fallback).
AGENT_ROUTER_MODE=rules
AGENT_RUN_STALLED_TIMEOUT_SECONDS=660
AGENT_RUN_MAX_ATTEMPTS=3
MAX_CONCURRENT_AGENT_RUNS_PER_TENANT=10

# --- Knowledge / RAG (pgvector) ------------------------------------------------------------
# Gemini embeddings use GEMINI_EMBEDDING_MODEL at VECTOR_EMBEDDING_DIMENSIONS; keep the
# dimensions at 1536 (the vector column size). RAG_EMBEDDING_MODEL applies to OpenAI only.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
VECTOR_EMBEDDING_DIMENSIONS=1536
VECTOR_MIN_SIMILARITY=0.0
# Only needed if RAG_EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_MAX_EXTRACTED_BYTES=5242880
RAG_URL_FETCH_TIMEOUT_SECONDS=30

# --- Tools / MCP ---------------------------------------------------------------------------
EXTERNAL_API_TIMEOUT_SECONDS=20
TOOL_MAX_RESPONSE_BYTES=1048576
TOOL_MAX_OUTPUT_CHARS=20000
TOOL_MAX_ARGUMENT_BYTES=262144
TOOL_EGRESS_DENYLIST=metadata.google.internal,*.internal,*.local
TOOL_APPROVAL_TTL_SECONDS=86400
BROWSER_TOOL_ENABLED=false
ENABLE_MCP=true
MCP_TOOL_TIMEOUT_SECONDS=30
# Optional integrations: leave empty to keep the tool disabled.
SEARCH_API_BASE=https://api.search.brave.com/res/v1/web/search
SEARCH_API_KEY=
GITHUB_API_BASE=https://api.github.com
GITHUB_APP_ID=
# PEM on one line with literal \n line breaks.
GITHUB_APP_PRIVATE_KEY=
TOOL_GITHUB_BRANCH_PREFIX=jt-code/
SLACK_API_BASE=https://slack.com/api

# --- Billing (Stripe live keys: sk_live_/rk_live_, whsec_, pk_live_) ----------------------
BILLING_CREDIT_VALUE_USD=0.01
BILLING_FX_BUFFER=1.05
BILLING_MARGIN_MULTIPLIER=1.25
BILLING_DEFAULT_PLAN=free
STRIPE_PUBLISHABLE_KEY=

# --- n8n -----------------------------------------------------------------------------------
N8N_WORKFLOW_PREFIX=jt-code

# --- Governance and outbound webhooks ------------------------------------------------------
AUDIT_EVENT_RETENTION_DAYS=2555
SAFETY_EVENT_RETENTION_DAYS=2555
CONSENT_VERSION=1.0
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BASE_DELAY=60
WEBHOOK_RETRY_MAX_SECONDS=3600
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10

# --- Rate limits (per user; tenants get the plan multiplier) -------------------------------
THROTTLE_CHAT=60/hour
THROTTLE_IMAGES=30/hour
THROTTLE_EMBEDDINGS=120/hour
THROTTLE_CONVERSIONS=20/hour
THROTTLE_RESEARCH=10/hour
THROTTLE_BURST=30/minute
THROTTLE_AGENT_RUNS=20/hour
