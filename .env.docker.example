# Local full-Docker stack: compose.yaml + compose.local.yaml on this machine (localhost only).
#   make docker-up     # first run creates .env.docker from this file, then starts everything
#
# Empty secrets below are generated by scripts/compose_env.py and then kept: the database and
# broker volumes are initialised with them. Never commit .env.docker. Integrations and tunables
# (Gemini, Stripe test keys, Sentry, search, RAG/agent limits) are copied from your native .env
# when it sets them; they stay optional here. Database, Redis, Kafka and Supabase connection
# URLs are wired by compose.yaml; do not set them here.

# --- Generated secrets ---------------------------------------------------------------------
SUPABASE_DB_PASSWORD=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SIGNING_SECRET=
REDIS_CACHE_PASSWORD=
REDIS_BROKER_PASSWORD=
KAFKA_ADMIN_PASSWORD=
KAFKA_PRODUCER_PASSWORD=
KAFKA_CONSUMER_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
DJANGO_SECRET_KEY=
METRICS_AUTH_TOKEN=
WEBHOOK_SIGNING_SECRET=
N8N_DISPATCH_SECRET=
N8N_WEBHOOK_SECRET=
N8N_SENTRY_RELAY_SECRET=
TOOL_CREDENTIALS_ENCRYPTION_KEYS=

# --- Addresses (the frontend dev server runs on :5173) ------------------------------------
SUPABASE_PUBLIC_URL=http://localhost:54321
SUPABASE_SITE_URL=http://localhost:5173
SUPABASE_REDIRECT_URLS=http://localhost:5173/**
FRONTEND_URL=http://localhost:5173
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_DEBUG=true

# --- Auth e-mail (SMTP: Gmail; Mailpit at http://127.0.0.1:8025 only when selected below) ---------
SUPABASE_MAILER_AUTOCONFIRM=false

# Email (SMTP): Supabase Auth sends sign-up confirmations and password resets with it, and the API
# uses it for any mail it sends. Gmail: turn on 2-Step Verification for the account, create an App
# Password at https://myaccount.google.com/apppasswords and paste its 16 characters (no spaces) as
# SMTP_PASSWORD. Gmail sends from SMTP_USER (or an alias verified in Gmail), ~500 recipients/day.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=tihabwangyej@gmail.com
SMTP_PASSWORD=izzumlzphgdazywu
SMTP_FROM_EMAIL=tihabwangyej@gmail.com
SMTP_FROM_NAME=JT-Code
SUPABASE_DISABLE_SIGNUP=false

# --- Naming ----------------------------------------------------------------------------------
KAFKA_TOPIC_PREFIX=jt-code.local
KAFKA_CONSUMER_GROUP_PREFIX=jt-code-local
SUPABASE_STORAGE_BUCKET=jt-code-assets
SUPABASE_STORAGE_PREFIX=jt-code/local
SENTRY_ENVIRONMENT=local-docker

# --- n8n (optional): an n8n on this machine is reached from the containers by host name -----
N8N_BASE_URL=http://host.docker.internal:5678
N8N_WEBHOOK_BASE_URL=http://host.docker.internal:5678
N8N_CALLBACK_BASE_URL=http://localhost:8000/api/v1

# --- Sizing for a laptop -----------------------------------------------------------------------
KAFKA_MEMORY=768M
WORKER_CONCURRENCY=2
WEB_CONCURRENCY=2
REDIS_CACHE_MAXMEMORY=128mb
REDIS_BROKER_MAXMEMORY=256mb
PROMETHEUS_RETENTION=3d
