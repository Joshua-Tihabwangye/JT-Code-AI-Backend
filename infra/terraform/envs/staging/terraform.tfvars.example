# Copy to staging.tfvars (git-ignored). Secrets are better passed as TF_VAR_* from the CI secret store.
kube_context             = "jt-code-staging"
zone_name                = "example.com"
cloudflare_zone_id       = "<zone id>"
frontend_url             = "https://app.staging.example.com"
supabase_organization_id = "<supabase org id>"
supabase_region          = "eu-central-1"
supabase_pooler_host     = "aws-0-eu-central-1.pooler.supabase.com"
cloudflare_ip_ranges     = ["173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22", "141.101.64.0/18", "108.162.192.0/18", "190.93.240.0/20", "188.114.96.0/20", "197.234.240.0/22", "198.41.128.0/17", "162.158.0.0/15", "104.16.0.0/13", "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22"]
admin_allowed_cidrs      = ["203.0.113.0/24"]
acme_email               = "ops@example.com"
traces_backend_endpoint  = "https://tempo.example.com"
registry_username        = "joshua-tihabwangye"
# cloudflare_api_token, supabase_access_token, grafana_admin_password, registry_token and
# external_secrets: set TF_VAR_<name> (external_secrets as a JSON object with the keys of
# infra/k8s/secret-keys.txt that Terraform does not generate).
