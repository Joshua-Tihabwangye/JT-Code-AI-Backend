# n8n deployment environment (copy to n8n.env; never commit the real file).
N8N_VERSION=1.88.0
N8N_HOST=n8n.example.com
# Public URL of the webhook processors (Django dispatches here: N8N_WEBHOOK_BASE_URL).
WEBHOOK_URL=https://n8n-hooks.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/
# 32+ random bytes; encrypts n8n credentials at rest. Back it up: it cannot be recovered.
N8N_ENCRYPTION_KEY=
QUEUE_BULL_REDIS_PASSWORD=

# Supabase PostgreSQL (session pooler or direct), role "n8n" from supabase-n8n-role.sql.
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=

# JT-Code contract (must match the Django settings named in brackets).
JT_CODE_API_BASE_URL=https://api.example.com/api/v1      # [N8N_CALLBACK_BASE_URL]
JT_CODE_DISPATCH_SECRET=                                  # [N8N_DISPATCH_SECRET]  Django -> n8n
JT_CODE_CALLBACK_SECRET=                                  # [N8N_WEBHOOK_SECRET]   n8n -> Django
JT_CODE_RELAY_SECRET=                                     # [N8N_SENTRY_RELAY_SECRET] error workflow
JT_CODE_SIGNATURE_TOLERANCE_SECONDS=300                   # [WEBHOOK_REPLAY_TOLERANCE_SECONDS]
JT_CODE_NOTIFICATIONS_FROM=notifications@example.com
JT_CODE_OPS_SLACK_CHANNEL=C0123456789
