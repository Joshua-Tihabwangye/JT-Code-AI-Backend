# Non-secret configuration for staging. Secrets live in the jt-code-secrets Secret
# (created by infra/terraform from the keys in infra/k8s/secret-keys.txt).
DJANGO_SETTINGS_MODULE=config.settings.staging
API_HOST=api.staging.example.com
ANALYTICS_HOST=analytics.staging.example.com
DJANGO_ALLOWED_HOSTS=api.staging.example.com
CORS_ALLOWED_ORIGINS=https://app.staging.example.com
CSRF_TRUSTED_ORIGINS=https://app.staging.example.com
FRONTEND_URL=https://app.staging.example.com
SENTRY_ENVIRONMENT=staging
OTEL_ENVIRONMENT=staging
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.monitoring.svc.cluster.local:4318
OTEL_TRACES_SAMPLE_RATIO=1.0
SENTRY_TRACES_SAMPLE_RATE=0.5
TRUSTED_PROXY_HOPS=1
CLOUDFLARE_ENFORCE_ORIGIN=true
WEBHOOK_ALLOWED_HOSTS=callbacks.example.com
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_TOPIC_PREFIX=jt-code.staging
DATABASE_POOLER_MODE=transaction
DATABASE_CONN_MAX_AGE=0
HEALTHCHECK_EXTERNAL_DEPENDENCIES=true
AI_PROVIDER=gemini
RAG_EMBEDDING_PROVIDER=gemini
N8N_BASE_URL=https://n8n.staging.example.com
N8N_WEBHOOK_BASE_URL=https://n8n-hooks.staging.example.com
N8N_CALLBACK_BASE_URL=https://api.staging.example.com/api/v1
SUPABASE_STORAGE_BUCKET=jt-code-assets
SUPABASE_STORAGE_PREFIX=jt-code/staging
