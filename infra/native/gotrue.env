# Supabase Auth (GoTrue) for the native local stack. Rendered by scripts/native/configure.py.
GOTRUE_API_HOST=127.0.0.1
PORT=${GOTRUE_PORT}
API_EXTERNAL_URL=${SUPABASE_PUBLIC_URL}/auth/v1
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=postgresql://supabase_auth_admin:${JT_SUPABASE_DB_PASSWORD}@127.0.0.1:5432/jt_code?search_path=auth
GOTRUE_DB_NAMESPACE=auth
GOTRUE_DB_MIGRATIONS_PATH=${OPT_DIR}/gotrue/migrations
GOTRUE_SITE_URL=http://localhost:5173
GOTRUE_URI_ALLOW_LIST=http://localhost:5173,http://127.0.0.1:5173
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_SECRET=${JT_SUPABASE_JWT_SECRET}
GOTRUE_JWT_ISSUER=${SUPABASE_PUBLIC_URL}/auth/v1
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMTP_ADMIN_EMAIL=admin@jt-code.local
GOTRUE_SMTP_HOST=127.0.0.1
GOTRUE_SMTP_PORT=${MAILPIT_SMTP_PORT}
GOTRUE_SMTP_SENDER_NAME=JT-Code Local
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
GOTRUE_MAILER_TEMPLATES_RECOVERY=http://127.0.0.1:54321/templates/recovery.html
GOTRUE_MAILER_SUBJECTS_RECOVERY=Your JT-Code password reset code
GOTRUE_EXTERNAL_PHONE_ENABLED=false
