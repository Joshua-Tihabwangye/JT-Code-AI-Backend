# Supabase Storage API for the native local stack. Rendered by scripts/native/configure.py.
SERVER_HOST=127.0.0.1
SERVER_PORT=${STORAGE_PORT}
ANON_KEY=${JT_SUPABASE_ANON_KEY}
SERVICE_KEY=${JT_SUPABASE_SERVICE_ROLE_KEY}
POSTGREST_URL=http://127.0.0.1:${POSTGREST_PORT}
AUTH_JWT_SECRET=${JT_SUPABASE_JWT_SECRET}
DATABASE_URL=postgresql://supabase_storage_admin:${JT_SUPABASE_DB_PASSWORD}@127.0.0.1:5432/jt_code
# Roles are created by scripts/native/bootstrap_system.sh, not by Storage's migrations.
DB_INSTALL_ROLES=false
STORAGE_PUBLIC_URL=${SUPABASE_PUBLIC_URL}
REQUEST_ALLOW_X_FORWARDED_PATH=true
FILE_SIZE_LIMIT=${ASSET_MAX_UPLOAD_BYTES}
STORAGE_BACKEND=file
GLOBAL_S3_BUCKET=local
FILE_STORAGE_BACKEND_PATH=${DATA_DIR}/storage
TENANT_ID=jt-code-local
REGION=local
# No imgproxy in the native stack; the API never requests image transforms.
ENABLE_IMAGE_TRANSFORMATION=false
