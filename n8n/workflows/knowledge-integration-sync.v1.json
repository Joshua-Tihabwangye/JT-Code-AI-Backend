    {
      "parameters": {
        "jsCode": "const config = $('Sync request').first().json.config;\nconst prefix = (config.path || '').replace(/^\\/+/, '');\nreturn ($input.first().json.tree || [])\n  .filter((f) => f.type === 'blob' && /\\.(md|mdx|txt|rst)$/i.test(f.path) && f.path.startsWith(prefix))\n  .slice(0, 500).map((f) => ({ json: { path: f.path, sha: f.sha } }));\n"
