        "jsCode": "const pages = $('Notion: each page').all();\nconst text = (block) => ((block[block.type] || {}).rich_text || []).map((t) => t.plain_text).join('');\nreturn $input.all().filter((item, i) => pages[i] && pages[i].json.id).map((item, i) => {\n  const page = pages[i].json;\n  const title = Object.values(page.properties || {}).filter((p) => p.type === 'title')\n    .map((p) => p.title.map((t) => t.plain_text).join('')).join(' ') || page.id;\n  return { json: { document: { externalId: `notion:${page.id}`, title,\n    text: (item.json.results || []).map(text).filter(Boolean).join('\\n'), mimeType: 'text/plain',\n    externalUrl: page.url, updatedAt: page.last_edited_time } } };\n}).filter((item) => item.json.document.text);\n"
