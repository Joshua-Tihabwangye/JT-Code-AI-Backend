    {
      "parameters": {
        "jsCode": "const files = $('Drive: each file').all();\nreturn $input.all().map((item, i) => {\n  const file = (files[i] || { json: {} }).json;\n  return { json: { document: { externalId: `gdrive:${file.id}`, title: file.name,\n    text: typeof item.json.data === 'string' ? item.json.data : '', mimeType: 'text/plain',\n    externalUrl: file.webViewLink, updatedAt: file.modifiedTime } } };\n}).filter((item) => item.json.document.text && !item.json.document.externalId.endsWith('undefined'));\n"
      },
