    {
      "parameters": {
        "jsCode": "const config = $('Sync request').first().json.config;\nconst messages = ($input.first().json.messages || []).filter((m) => m.text).reverse();\nif (!messages.length) return [];\nreturn [{ json: { document: { externalId: `slack:${config.channelId}`,\n  title: `Slack #${config.channelName || config.channelId}`,\n  text: messages.map((m) => m.text).join('\\n'), mimeType: 'text/plain',\n  updatedAt: new Date(Number(messages[messages.length - 1].ts) * 1000).toISOString() } } }];\n"
      },
      "id": "9580e418-4594-5a7a-9e1f-d192f1f3bbbf",
      "name": "Slack: documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
