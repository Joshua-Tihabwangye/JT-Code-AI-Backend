        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const request = $('Sync request').first().json.request;\nconst documents = $input.all().map((item) => item.json.document).filter((doc) => doc && doc.externalId);\nconst size = 25;\nconst batches = [];\nfor (let i = 0; i < documents.length; i += size) batches.push(documents.slice(i, i + size));\nif (!batches.length) batches.push([]);\nreturn batches.map((chunk, i) => ({ json: {\n  callbackUrl: request.callbacks.documents, traceparent: request.traceparent || '',\n  callbackBody: { deliveryId: request.deliveryId, syncRunId: request.data.syncRunId, documents: chunk,\n    final: i === batches.length - 1 } } }));\n"
      },
      "id": "a3cf1966-8a49-54bb-be25-e54cfc8ce720",
      "name": "Batch documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sign callbacks to JT-Code: v1=HMAC-SHA256(secret, \"<ts>.<nonce>.\" + body).\nconst crypto = require('crypto');\nconst secret = $env.JT_CODE_CALLBACK_SECRET;\nif (!secret) throw new Error('JT_CODE_CALLBACK_SECRET is not configured');\nreturn $input.all().map((item) => {\n  const body = JSON.stringify(item.json.callbackBody);\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const nonce = crypto.randomBytes(18).toString('base64url');\n  const digest = crypto.createHmac('sha256', secret).update(`${timestamp}.${nonce}.${body}`).digest('hex');\n  return { json: {\n    url: item.json.callbackUrl,\n    body,\n    timestamp,\n    nonce,\n    signature: `v1=${digest}`,\n    traceparent: item.json.traceparent || '',\n  } };\n});\n"
      },
      "id": "424171cd-9038-59aa-8b8b-9a837c868386",
      "name": "Sign documents",
