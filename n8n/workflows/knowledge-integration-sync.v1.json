      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-JT-Code-Timestamp",
              "value": "={{ $json.timestamp }}"
