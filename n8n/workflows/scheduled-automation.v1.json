        "jsCode": "// Verify the JT-Code dispatch signature (see apps/core/signing.py).\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst secret = $env.JT_CODE_DISPATCH_SECRET;\nconst tolerance = Number($env.JT_CODE_SIGNATURE_TOLERANCE_SECONDS || 300);\nconst timestamp = String(headers['x-jt-code-timestamp'] || '');\nconst nonce = String(headers['x-jt-code-nonce'] || '');\nconst supplied = String(headers['x-jt-code-signature'] || '')\n  .split(',').map((part) => part.trim()).filter((part) => part.startsWith('v1=')).map((part) => part.slice(3));\nlet reason = '';\nlet raw = Buffer.from('');\ntry {\n  raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n} catch (error) {\n  reason = 'missing raw body';\n}\nif (!secret) reason = 'JT_CODE_DISPATCH_SECRET is not configured';\nif (!reason && (!/^\\d+$/.test(timestamp) || !/^[A-Za-z0-9_-]{16,128}$/.test(nonce) || supplied.length === 0)) {\n  reason = 'missing signature headers';\n}\nif (!reason && Math.abs(Date.now() / 1000 - Number(timestamp)) > tolerance) reason = 'stale timestamp';\nif (!reason) {\n  const expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${nonce}.`).update(raw).digest('hex');\n  const match = supplied.some((value) => value.length === expected.length\n    && crypto.timingSafeEqual(Buffer.from(value), Buffer.from(expected)));\n  if (!match) reason = 'invalid signature';\n}\nif (!reason) {\n  // Best-effort replay guard; Django's run attempt and delivery ids are the durable one.\n  const store = $getWorkflowStaticData('global');\n  const now = Date.now();\n  store.nonces = (store.nonces || []).filter((entry) => entry.t > now - tolerance * 2000);\n  if (store.nonces.some((entry) => entry.v === nonce)) reason = 'replayed request';\n  else store.nonces.push({ v: nonce, t: now });\n}\nif (reason) return [{ json: { verified: false, reason } }];\nreturn [{ json: { verified: true, payload: JSON.parse(raw.toString('utf8')) } }];\n"
